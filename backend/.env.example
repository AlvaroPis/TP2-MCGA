# Servidor
PORT=3000
NODE_ENV=development

# MongoDB (Atlas o local). Formato: mongodb+srv://<usuario>:<password>@<cluster>/<base>
MONGODB_URI=

# Better Auth
# Generar con: npx @better-auth/cli secret  (o cualquier string aleatorio de 32+ caracteres)
BETTER_AUTH_SECRET=
# URL publica desde donde el navegador llega a /api/auth.
# Local: http://localhost:5173 (Vite hace proxy de /api). Produccion: la URL del frontend en Render.
BETTER_AUTH_URL=
# Origen del frontend (CORS + trustedOrigins de Better Auth)
FRONTEND_URL=

# GitHub OAuth App (callback: <BETTER_AUTH_URL>/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Usuarios de prueba que crea `npm run seed` (opcionales: si se dejan vacios se usan los del README)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
