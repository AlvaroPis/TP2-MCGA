{
  "name": "recetario-backend",
  "version": "1.0.0",
  "description": "API REST del Recetario (Express + TypeScript + MongoDB + Better Auth)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "typecheck": "tsc --noEmit"
  },
  "author": "Alvaro Pistelli",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "better-auth": "^1.7.27",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongodb": "^7.9.1",
    "mongoose": "^9.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
